SLACK_SIGNING_SECRET=replace-me
SLACK_BOT_TOKEN=xoxb-replace-me
GITHUB_TOKEN=github_pat_replace-me

# Find member IDs in Slack under Profile → More → Copy member ID.
ALLOWED_SLACK_USER_IDS=U0123456789
ALLOW_ALL_USERS=false
ALLOW_CHANNEL_MESSAGES=false

# Optional review theater. Separate choices with a pipe.
APPROVAL_COMMENTS=nice commas|the abstractions yearn for the mines|ran it locally (spiritually)
COMMENT_PROBABILITY=0.25
APPROVAL_REVIEW_BODY=LGTM from OOO-land 🌴

DRY_RUN=true
LISTEN_ADDR=0.0.0.0:3000
RUST_LOG=approve_bot=info

# GitHub Enterprise example:
# GITHUB_API_URL=https://git.example.com/api/v3/
# GITHUB_WEB_HOST=git.example.com
